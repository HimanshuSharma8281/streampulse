# ==========================================================
# StreamPulse Environment Variables Configuration (Template)
# Copy this file to .env.local and fill in your values
# ==========================================================

# Admin Login Credentials (Protected on server, NEVER exposed to client)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_secure_password

# Razorpay Payment Gateway (Test Mode / Live Mode)
# 1. Public Key ID (Safe for frontend checkout script)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# 2. Secret Key (SERVER ONLY - NEVER expose to frontend or GitHub)
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Optional: Supabase Database and Auth Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
